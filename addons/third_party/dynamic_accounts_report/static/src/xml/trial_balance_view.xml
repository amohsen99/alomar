<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!--
    Trial Balance Template - Enterprise Grade
    Responsive hierarchy, dark control bar, executive KPI cards, glassmorphic filters, and tabular financial formatting.
    -->
    <t t-name="trl_b_template_new" owl="1">
        <div class="o_partner_ledger_container">
            <!-- Header Control Bar (Enterprise Dark Bar) -->
            <div class="o_report_control_bar">
                <div class="o_report_header_left">
                    <h2 class="o_report_main_title">
                        <i class="fa fa-balance-scale me-2"/>
                        <t t-esc="state.title || 'Trial Balance'"/>
                    </h2>
                    <!-- Action Buttons -->
                    <button type="button"
                            class="o_btn_report_action o_btn_pdf"
                            t-on-click="printPdf"
                            title="Print PDF Report">
                        <i class="fa fa-file-pdf-o"/> Print (PDF)
                    </button>
                    <button type="button"
                            class="o_btn_report_action o_btn_xlsx"
                            t-on-click="print_xlsx"
                            title="Export XLSX Spreadsheet">
                        <i class="fa fa-file-excel-o"/> Export (XLSX)
                    </button>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-2">
                    <!-- Real-Time Search Box -->
                    <div class="o_report_search_wrapper">
                        <i class="fa fa-search o_search_icon"/>
                        <input type="text"
                               class="form-control form-control-sm o_report_search_input"
                               placeholder="Search code or account..."
                               t-on-input="onSearchInput"/>
                    </div>

                    <!-- Filter Pills -->
                    <div class="o_filter_pills_group">
                        <!-- 1. Date Range Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-calendar"/>
                                <span><t t-esc="state.date_filter_label || 'Date Range'"/></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width: 260px;" role="menu">
                                <div class="list-group list-group-flush mb-2">
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('month', 'This Month')">This Month</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('quarter', 'This Quarter')">This Quarter</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('year', 'This Year')">This Year</button>
                                    <div class="dropdown-divider my-1"/>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-month', 'Last Month')">Last Month</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-quarter', 'Last Quarter')">Last Quarter</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-year', 'Last Year')">Last Year</button>
                                </div>
                                <div class="dropdown-divider my-2"/>
                                <div class="mb-2">
                                    <label class="form-label text-muted small mb-1" for="tb_start_date">Start Date</label>
                                    <input type="date" id="tb_start_date" t-ref="start_date" class="form-control form-control-sm" t-on-change="applyCustomDate"/>
                                </div>
                                <div>
                                    <label class="form-label text-muted small mb-1" for="tb_end_date">End Date</label>
                                    <input type="date" id="tb_end_date" t-ref="end_date" class="form-control form-control-sm" t-on-change="applyCustomDate"/>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Comparison Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-signal"/>
                                <span><t t-esc="state.apply_comparison ? (state.comparison_type === 'year' ? 'Comparison (Year)' : 'Comparison (Period)') : 'Comparison'"/></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width: 250px;" role="menu">
                                <button class="dropdown-item py-1 mb-2" type="button" t-on-click="applyComparison">
                                    No Comparison
                                </button>
                                <div class="dropdown-divider my-2"/>
                                <div class="mb-2">
                                    <label class="form-label text-muted small mb-1">Previous Period(s):</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" t-ref="periods" min="1" max="12" class="form-control" placeholder="1" t-on-input="onPeriodChange"/>
                                        <button class="btn btn-primary" type="button" t-on-click="applyComparisonPeriod">Apply</button>
                                    </div>
                                </div>
                                <div class="dropdown-divider my-2"/>
                                <div>
                                    <label class="form-label text-muted small mb-1">Same Period Last Year(s):</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" t-ref="period_year" min="1" max="5" class="form-control" placeholder="1" t-on-input="onPeriodYearChange"/>
                                        <button class="btn btn-primary" type="button" t-on-click="applyComparisonYear">Apply</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Journals Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-book"/>
                                <span>Journals</span>
                                <t t-if="state.selected_journal_list and state.selected_journal_list.length > 0">
                                    <span class="badge bg-primary ms-1"><t t-esc="state.selected_journal_list.length"/></span>
                                </t>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-2" style="max-height: 280px; overflow-y: auto;" role="menu">
                                <t t-if="state.journals and state.journals.length > 0">
                                    <t t-foreach="state.journals" t-as="journal" t-key="journal.id">
                                        <button t-attf-class="dropdown-item py-1 d-flex align-items-center justify-content-between {{ state.selected_journal_list.includes(journal.id) ? 'active' : '' }}"
                                                type="button"
                                                t-on-click="() => this.toggleJournalFilter(journal.id)">
                                            <span><t t-esc="journal.name"/></span>
                                            <i t-if="state.selected_journal_list.includes(journal.id)" class="fa fa-check ms-2"/>
                                        </button>
                                    </t>
                                </t>
                                <t t-else="">
                                    <span class="dropdown-item text-muted py-1">No journals available</span>
                                </t>
                            </div>
                        </div>

                        <!-- 4. Options Filter (Posted / Draft & Method) -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-filter"/>
                                <span><t t-esc="state.target_move === 'draft' ? 'Include Draft' : 'Posted Only'"/></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-1" role="menu">
                                <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyTargetMove('posted')">
                                    Posted Entries Only
                                </button>
                                <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyTargetMove('draft')">
                                    Include Draft Entries
                                </button>
                                <div class="dropdown-divider my-1"/>
                                <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyMethod('accrual')">
                                    Accrual Basis
                                </button>
                                <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyMethod('cash-basis')">
                                    Cash Basis Method
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Informational Banner (Enterprise Alert Look) -->
            <div class="alert alert-info d-flex align-items-center mb-3 py-2 px-3" style="font-size: 12px; border-radius: 6px; background-color: #e7f5ff; border: 1px solid #b7dcf7; color: #0c5460;">
                <i class="fa fa-info-circle text-info me-2 fs-6"/>
                <span>Trial Balance summarizes opening balance, current period movement, and ending balance for all accounts to verify equality of debits and credits. Click on any account action to drill down into General Ledger or Journal Items.</span>
            </div>

            <!-- Table Card Container -->
            <div class="o_report_table_card">
                <div class="o_report_table_scrollable">
                    <table class="o_bs_table" cellspacing="0">
                        <thead>
                            <!-- Super Headers -->
                            <tr class="o_tb_super_header">
                                <th style="width: 34%; text-align: left; padding-left: 16px;">Account</th>
                                <th colspan="2" style="width: 22%;">Initial Balance</th>
                                <t t-if="state.apply_comparison and comparison_number_range and comparison_number_range.length > 0">
                                    <t t-foreach="comparison_number_range" t-as="num" t-key="num">
                                        <th colspan="2" style="width: 14%;">
                                            <t t-esc="state.date_viewed and state.date_viewed[num] ? state.date_viewed[num] : ('Period -' + num)"/>
                                        </th>
                                    </t>
                                </t>
                                <th colspan="2" style="width: 22%;">
                                    <t t-esc="state.date_viewed and state.date_viewed.length > 0 ? state.date_viewed[0] : 'Current Period'"/>
                                </th>
                                <th colspan="2" style="width: 22%;">End Balance</th>
                            </tr>
                            <!-- Sub Headers (Debit / Credit) -->
                            <tr class="o_tb_sub_header">
                                <th style="text-align: left; padding-left: 16px;">Code &amp; Name</th>
                                <th class="text-end" style="width: 11%;">Debit</th>
                                <th class="text-end" style="width: 11%;">Credit</th>
                                <t t-if="state.apply_comparison and comparison_number_range and comparison_number_range.length > 0">
                                    <t t-foreach="comparison_number_range" t-as="num" t-key="num">
                                        <th class="text-end" style="width: 7%;">Debit</th>
                                        <th class="text-end" style="width: 7%;">Credit</th>
                                    </t>
                                </t>
                                <th class="text-end" style="width: 11%;">Debit</th>
                                <th class="text-end" style="width: 11%;">Credit</th>
                                <th class="text-end" style="width: 11%;">Debit</th>
                                <th class="text-end" style="width: 11%;">Credit</th>
                            </tr>
                        </thead>
                        <tbody t-ref="tbody">
                            <t t-if="displayed_accounts and displayed_accounts.length > 0">
                                <t t-foreach="displayed_accounts" t-as="acc" t-key="acc.account_id">
                                    <tr class="o_tb_account_row">
                                        <td>
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="d-flex align-items-center text-truncate me-2">
                                                    <span class="o_tb_account_code_badge me-2" t-att-title="acc.account">
                                                        <t t-esc="acc.account_code || (acc.account ? acc.account.split(' ')[0] : '')"/>
                                                    </span>
                                                    <span class="o_tb_account_title text-truncate" t-att-title="acc.account">
                                                        <t t-esc="acc.account_name || acc.account"/>
                                                    </span>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <button type="button"
                                                            class="o_tb_action_btn"
                                                            t-on-click="(ev) => this.gotoJournalItem(acc.account_id, ev)"
                                                            title="View Journal Items">
                                                        <i class="fa fa-list"/> Items
                                                    </button>
                                                    <button type="button"
                                                            class="o_tb_action_btn"
                                                            t-on-click="(ev) => this.gotoGeneralLedger(acc.account_id, ev)"
                                                            title="View General Ledger">
                                                        <i class="fa fa-book"/> GL
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                        <!-- Initial Balance -->
                                        <td class="o_tb_cell_amount">
                                            <t t-esc="formatAmount(acc.initial_total_debit)"/>
                                        </td>
                                        <td class="o_tb_cell_amount">
                                            <t t-esc="formatAmount(acc.initial_total_credit)"/>
                                        </td>

                                        <!-- Comparison Periods -->
                                        <t t-if="state.apply_comparison and comparison_number_range and comparison_number_range.length > 0">
                                            <t t-foreach="comparison_number_range" t-as="num" t-key="num">
                                                <td class="o_tb_cell_amount">
                                                    <t t-esc="formatAmount(acc['dynamic_total_debit_' + num])"/>
                                                </td>
                                                <td class="o_tb_cell_amount">
                                                    <t t-esc="formatAmount(acc['dynamic_total_credit_' + num])"/>
                                                </td>
                                            </t>
                                        </t>

                                        <!-- Current Period Movement -->
                                        <td class="o_tb_cell_amount fw-semibold">
                                            <t t-esc="formatAmount(acc.total_debit)"/>
                                        </td>
                                        <td class="o_tb_cell_amount fw-semibold">
                                            <t t-esc="formatAmount(acc.total_credit)"/>
                                        </td>

                                        <!-- End Balance -->
                                        <td class="o_tb_cell_amount fw-bold" style="color: #0f172a;">
                                            <t t-esc="formatAmount(acc.end_total_debit)"/>
                                        </td>
                                        <td class="o_tb_cell_amount fw-bold" style="color: #0f172a;">
                                            <t t-esc="formatAmount(acc.end_total_credit)"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fa fa-folder-open-o fs-3 mb-2 d-block"/>
                                        <span>No trial balance data found for the selected criteria.</span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="text-end fw-bold py-3 px-3" style="font-size: 13px; background-color: #f1f5f9;">
                                    Grand Total
                                </td>
                                <!-- Initial Balance Totals -->
                                <td class="text-end fw-bold py-3" style="background-color: #f1f5f9;">
                                    <t t-esc="state.totals ? (state.totals.initial_total_debit || '0.00') : '0.00'"/>
                                </td>
                                <td class="text-end fw-bold py-3" style="background-color: #f1f5f9;">
                                    <t t-esc="state.totals ? (state.totals.initial_total_credit || '0.00') : '0.00'"/>
                                </td>

                                <!-- Comparison Period Totals -->
                                <t t-if="state.apply_comparison and comparison_number_range and comparison_number_range.length > 0">
                                    <t t-foreach="comparison_number_range" t-as="num" t-key="num">
                                        <td class="text-end fw-bold py-3" style="background-color: #f1f5f9;">
                                            <t t-esc="state.totals ? (state.totals['dynamic_total_debit_' + num] || '0.00') : '0.00'"/>
                                        </td>
                                        <td class="text-end fw-bold py-3" style="background-color: #f1f5f9;">
                                            <t t-esc="state.totals ? (state.totals['dynamic_total_credit_' + num] || '0.00') : '0.00'"/>
                                        </td>
                                    </t>
                                </t>

                                <!-- Current Period Movement Totals -->
                                <td class="text-end fw-bold py-3 text-primary" style="background-color: #f1f5f9;">
                                    <t t-esc="state.totals ? (state.totals.total_debit || formatNumber(total_period_debit)) : formatNumber(total_period_debit)"/>
                                </td>
                                <td class="text-end fw-bold py-3 text-primary" style="background-color: #f1f5f9;">
                                    <t t-esc="state.totals ? (state.totals.total_credit || formatNumber(total_period_credit)) : formatNumber(total_period_credit)"/>
                                </td>

                                <!-- End Balance Totals -->
                                <td class="text-end fw-bold py-3 text-success" style="background-color: #f1f5f9; font-size: 13px;">
                                    <t t-esc="state.totals ? (state.totals.end_total_debit || formatNumber(total_end_debit)) : formatNumber(total_end_debit)"/>
                                </td>
                                <td class="text-end fw-bold py-3 text-success" style="background-color: #f1f5f9; font-size: 13px;">
                                    <t t-esc="state.totals ? (state.totals.end_total_credit || formatNumber(total_end_credit)) : formatNumber(total_end_credit)"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>