<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!--
    Aged Payable Template - Enterprise Grade
    Responsive hierarchy, dark control bar, crisp filters, executive KPI cards, and tabular financial formatting.
    -->
    <t t-name="age_p_template_new" owl="1">
        <div class="o_partner_ledger_container">
            <!-- Header Control Bar (Enterprise Dark Bar) -->
            <div class="o_report_control_bar">
                <div class="o_report_header_left">
                    <h2 class="o_report_main_title">
                        <i class="fa fa-calendar-times-o me-2"/>
                        <t t-esc="state.title || 'Aged Payable'"/>
                    </h2>
                    <!-- Action Buttons -->
                    <button type="button"
                            class="o_btn_report_action o_btn_pdf"
                            t-on-click="printPdf"
                            title="Print PDF Report">
                        <i class="fa fa-file-pdf-o"/> Print (PDF)
                    </button>
                    <button type="button"
                            class="o_btn_report_action o_btn_xlsx"
                            t-on-click="print_xlsx"
                            title="Export XLSX Spreadsheet">
                        <i class="fa fa-file-excel-o"/> Export (XLSX)
                    </button>

                    <!-- Unfold/Fold Toggle Button -->
                    <button type="button"
                            class="btn btn-sm btn-outline-light ms-2 o_filter_chip"
                            style="border-radius: 6px; padding: 5px 12px;"
                            t-on-click="unfoldAll">
                        <i t-attf-class="fa fa-{{ state.is_unfolded_all ? 'compress' : 'expand' }} me-1"/>
                        <t t-esc="state.is_unfolded_all ? 'Fold All' : 'Unfold All'"/>
                    </button>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-2">
                    <!-- Real-Time Search Box -->
                    <div class="o_report_search_wrapper">
                        <i class="fa fa-search o_search_icon"/>
                        <input type="text"
                               class="form-control form-control-sm o_report_search_input"
                               placeholder="Search vendor or bill..."
                               t-on-input="onSearchInput"/>
                    </div>

                    <!-- Filter Pills -->
                    <div class="o_filter_pills_group">
                        <!-- Date Filter Dropdown -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-calendar"/>
                                <span><t t-esc="state.date_filter_label || 'Date Range'"/></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width: 250px;" role="menu">
                                <div class="list-group list-group-flush mb-2">
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('today', 'Today')">Today</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-month-end', 'End of Last Month')">End of Last Month</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-quarter-end', 'End of Last Quarter')">End of Last Quarter</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-year-end', 'End of Last Year')">End of Last Year</button>
                                </div>
                                <div class="dropdown-divider my-2"/>
                                <div>
                                    <label class="form-label text-muted small mb-1" for="ap_end_date">As of Date</label>
                                    <input type="date"
                                           id="ap_end_date"
                                           t-ref="date_to"
                                           class="form-control form-control-sm"
                                           t-on-change="applyCustomDate"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Executive KPI Dashboard -->
            <div class="o_report_kpi_bar">
                <div class="o_kpi_card">
                    <span class="o_kpi_title">Current (Not Due)</span>
                    <span class="o_kpi_value text-success"><t t-esc="state.currency"/> <t t-esc="state.diff0_sum_display || '0.00'"/></span>
                    <span class="o_kpi_sub">Due on or after target date</span>
                </div>
                <div class="o_kpi_card">
                    <span class="o_kpi_title">Overdue (1 - 60 Days)</span>
                    <span t-attf-class="o_kpi_value {{ (state.diff1_sum + state.diff2_sum) > 0 ? 'text-warning' : 'text-muted' }}">
                        <t t-esc="state.currency"/> <t t-esc="formatNumber(state.diff1_sum + state.diff2_sum)"/>
                    </span>
                    <span class="o_kpi_sub">Short-term overdue bills</span>
                </div>
                <div class="o_kpi_card">
                    <span class="o_kpi_title">Critical Overdue (&gt; 60 Days)</span>
                    <span t-attf-class="o_kpi_value {{ (state.diff3_sum + state.diff4_sum + state.diff5_sum) > 0 ? 'text-danger' : 'text-success' }}">
                        <t t-esc="state.currency"/> <t t-esc="formatNumber(state.diff3_sum + state.diff4_sum + state.diff5_sum)"/>
                    </span>
                    <span class="o_kpi_sub">Aged over 60 days</span>
                </div>
            </div>

            <!-- Informational Banner (Enterprise Alert Look) -->
            <div class="alert alert-info d-flex align-items-center mb-3 py-2 px-3" style="font-size: 12px; border-radius: 6px; background-color: #e7f5ff; border: 1px solid #b7dcf7; color: #0c5460;">
                <i class="fa fa-info-circle text-info me-2 fs-6"/>
                <span>Aged Payable report categorizes vendor liabilities by maturity intervals. Click any vendor row to fold/unfold bills, or click a bill to inspect the journal entry.</span>
            </div>

            <!-- Table Card Container -->
            <div class="o_report_table_card">
                <div class="o_report_table_scrollable">
                    <table class="o_bs_table" cellspacing="0">
                        <thead>
                            <tr>
                                <th style="width: 26%;">Vendor / Bill</th>
                                <th style="width: 8%;">Bill Date</th>
                                <th style="width: 8%;">Due Date</th>
                                <th style="width: 13%;">Account</th>
                                <th class="text-end" style="width: 8%;">Current</th>
                                <th class="text-end" style="width: 6%;">1 - 30</th>
                                <th class="text-end" style="width: 6%;">31 - 60</th>
                                <th class="text-end" style="width: 6%;">61 - 90</th>
                                <th class="text-end" style="width: 6%;">91 - 120</th>
                                <th class="text-end" style="width: 6%;">Older</th>
                                <th class="text-end" style="width: 7%;">Total Due</th>
                            </tr>
                        </thead>
                        <tbody t-ref="tbody">
                            <t t-if="state.move_line and state.move_line.length > 0">
                                <t t-foreach="displayed_partners" t-as="partner" t-key="partner">
                                    <!-- Partner Header Row -->
                                    <tr class="o_ar_partner_header" t-on-click="() => this.togglePartner(partner)">
                                        <td colspan="4">
                                            <span class="o_toggle_caret me-2">
                                                <i t-attf-class="fa fa-caret-{{ isPartnerExpanded(partner) ? 'down text-primary' : 'right text-muted' }}"/>
                                            </span>
                                            <span class="o_ar_partner_title"><t t-esc="partner"/></span>
                                            <t t-if="state.total and state.total[partner]">
                                                <button type="button"
                                                        class="o_ar_action_btn ms-2"
                                                        t-on-click="(ev) => this.openPartner(state.total[partner].partner_id, ev)"
                                                        title="Open Vendor Form">
                                                    <i class="fa fa-user me-1 text-primary"/> Vendor
                                                </button>
                                                <button type="button"
                                                        class="o_ar_action_btn ms-1"
                                                        t-on-click="(ev) => this.gotoJournalItem(state.total[partner].partner_id, ev)"
                                                        title="View Journal Items">
                                                    <i class="fa fa-list me-1 text-info"/> Journal Items
                                                </button>
                                            </t>
                                        </td>
                                        <td class="text-end fw-semibold">
                                            <t t-if="state.total and state.total[partner]">
                                                <t t-esc="formatBucket(state.total[partner].diff0_sum)"/>
                                            </t>
                                        </td>
                                        <td t-attf-class="text-end {{ state.total and state.total[partner] and state.total[partner].diff1_sum > 0 ? 'text-warning fw-semibold' : 'text-muted' }}">
                                            <t t-if="state.total and state.total[partner]">
                                                <t t-esc="formatBucket(state.total[partner].diff1_sum)"/>
                                            </t>
                                        </td>
                                        <td t-attf-class="text-end {{ state.total and state.total[partner] and state.total[partner].diff2_sum > 0 ? 'text-danger fw-semibold' : 'text-muted' }}">
                                            <t t-if="state.total and state.total[partner]">
                                                <t t-esc="formatBucket(state.total[partner].diff2_sum)"/>
                                            </t>
                                        </td>
                                        <td t-attf-class="text-end {{ state.total and state.total[partner] and state.total[partner].diff3_sum > 0 ? 'text-danger fw-bold' : 'text-muted' }}">
                                            <t t-if="state.total and state.total[partner]">
                                                <t t-esc="formatBucket(state.total[partner].diff3_sum)"/>
                                            </t>
                                        </td>
                                        <td t-attf-class="text-end {{ state.total and state.total[partner] and state.total[partner].diff4_sum > 0 ? 'text-danger fw-bold' : 'text-muted' }}">
                                            <t t-if="state.total and state.total[partner]">
                                                <t t-esc="formatBucket(state.total[partner].diff4_sum)"/>
                                            </t>
                                        </td>
                                        <td t-attf-class="text-end {{ state.total and state.total[partner] and state.total[partner].diff5_sum > 0 ? 'text-danger fw-bold' : 'text-muted' }}">
                                            <t t-if="state.total and state.total[partner]">
                                                <t t-esc="formatBucket(state.total[partner].diff5_sum)"/>
                                            </t>
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            <t t-if="state.total and state.total[partner]">
                                                <t t-esc="formatNumber(state.total[partner].credit_sum)"/>
                                            </t>
                                        </td>
                                    </tr>

                                    <!-- Invoice Detail Rows -->
                                    <t t-if="state.data and state.data[partner]">
                                        <t t-foreach="state.data[partner]" t-as="line" t-key="line.id">
                                            <tr t-attf-class="o_ar_line_row {{ isPartnerExpanded(partner) ? '' : 'd-none' }}">
                                                <td class="ps-4">
                                                    <a href="#"
                                                       class="o_ar_move_link"
                                                       t-on-click="(ev) => this.gotoJournalEntry(line.move_id[0], ev)"
                                                       title="Click to view journal entry">
                                                        <i class="fa fa-file-text-o me-1 text-muted"/>
                                                        <span class="fw-semibold"><t t-esc="line.move_name"/></span>
                                                        <t t-if="line.name and line.name != line.move_name">
                                                            <span class="text-muted small ms-1">(<t t-esc="line.name"/>)</span>
                                                        </t>
                                                    </a>
                                                </td>
                                                <td class="text-muted"><t t-esc="line.date"/></td>
                                                <td class="text-muted"><t t-esc="line.date_maturity || '-'"/></td>
                                                <td>
                                                    <span class="badge bg-light text-dark border" style="font-size: 11px;">
                                                        <t t-esc="line.account_id[1]"/>
                                                    </span>
                                                </td>
                                                <td class="text-end text-muted"><t t-esc="formatBucket(line.raw_diff0)"/></td>
                                                <td t-attf-class="text-end {{ line.raw_diff1 > 0 ? 'text-warning' : 'text-muted' }}"><t t-esc="formatBucket(line.raw_diff1)"/></td>
                                                <td t-attf-class="text-end {{ line.raw_diff2 > 0 ? 'text-danger' : 'text-muted' }}"><t t-esc="formatBucket(line.raw_diff2)"/></td>
                                                <td t-attf-class="text-end {{ line.raw_diff3 > 0 ? 'text-danger fw-semibold' : 'text-muted' }}"><t t-esc="formatBucket(line.raw_diff3)"/></td>
                                                <td t-attf-class="text-end {{ line.raw_diff4 > 0 ? 'text-danger fw-semibold' : 'text-muted' }}"><t t-esc="formatBucket(line.raw_diff4)"/></td>
                                                <td t-attf-class="text-end {{ line.raw_diff5 > 0 ? 'text-danger fw-bold' : 'text-muted' }}"><t t-esc="formatBucket(line.raw_diff5)"/></td>
                                                <td class="text-end fw-semibold"><t t-esc="formatNumber(line.raw_credit)"/></td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>

                                <!-- Grand Total Summary Row -->
                                <tr class="o_report_grand_total">
                                    <td colspan="4" class="fw-bold text-uppercase ps-3">Grand Total</td>
                                    <td class="text-end fw-bold"><t t-esc="state.diff0_sum_display"/></td>
                                    <td t-attf-class="text-end fw-bold {{ state.diff1_sum > 0 ? 'text-warning' : '' }}"><t t-esc="state.diff1_sum_display"/></td>
                                    <td t-attf-class="text-end fw-bold {{ state.diff2_sum > 0 ? 'text-danger' : '' }}"><t t-esc="state.diff2_sum_display"/></td>
                                    <td t-attf-class="text-end fw-bold {{ state.diff3_sum > 0 ? 'text-danger' : '' }}"><t t-esc="state.diff3_sum_display"/></td>
                                    <td t-attf-class="text-end fw-bold {{ state.diff4_sum > 0 ? 'text-danger' : '' }}"><t t-esc="state.diff4_sum_display"/></td>
                                    <td t-attf-class="text-end fw-bold {{ state.diff5_sum > 0 ? 'text-danger' : '' }}"><t t-esc="state.diff5_sum_display"/></td>
                                    <td class="text-end fw-bold text-primary"><t t-esc="state.total_credit_display"/></td>
                                </tr>
                            </t>

                            <!-- Empty Search / No Data State -->
                            <t t-else="">
                                <tr>
                                    <td colspan="11" class="text-center py-5 text-muted">
                                        <i class="fa fa-folder-open-o fa-3x mb-3 text-secondary"/>
                                        <h5 class="fw-semibold">No Outstanding Payable Records Found</h5>
                                        <p class="small mb-0">All vendor liabilities are settled or no records match the active criteria.</p>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
