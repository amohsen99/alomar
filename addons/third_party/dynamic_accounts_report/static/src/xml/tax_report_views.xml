<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!--
    Tax Report Template - Enterprise Grade
    Responsive hierarchy, dark control bar, crisp filters, executive KPI cards, and financial formatting.
    -->
    <t t-name="tax_r_template_new" owl="1">
        <div class="o_partner_ledger_container">
            <!-- Header Control Bar (Enterprise Dark Bar) -->
            <div class="o_report_control_bar">
                <div class="o_report_header_left">
                    <h2 class="o_report_main_title">
                        <i class="fa fa-percent me-2"/>
                        <t t-esc="state.title || 'Tax Report'"/>
                    </h2>
                    <!-- Action Buttons -->
                    <button type="button"
                            class="o_btn_report_action o_btn_pdf"
                            t-on-click="printPdf"
                            title="Print PDF Report">
                        <i class="fa fa-file-pdf-o"/> Print (PDF)
                    </button>
                    <button type="button"
                            class="o_btn_report_action o_btn_xlsx"
                            t-on-click="print_xlsx"
                            title="Export XLSX Spreadsheet">
                        <i class="fa fa-file-excel-o"/> Export (XLSX)
                    </button>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-2">
                    <!-- Filter Pills Group -->
                    <div class="o_filter_pills_group">
                        <!-- Date Range Dropdown -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-calendar"/>
                                <span><t t-esc="state.date_filter_label || 'Date Range'"/></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width: 260px;" role="menu">
                                <div class="list-group list-group-flush mb-2">
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('month', 'This Month')">This Month</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('quarter', 'This Quarter')">This Quarter</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('year', 'This Year')">This Year</button>
                                    <div class="dropdown-divider my-1"/>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-month', 'Last Month')">Last Month</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-quarter', 'Last Quarter')">Last Quarter</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-year', 'Last Year')">Last Year</button>
                                </div>
                                <div class="dropdown-divider my-2"/>
                                <div class="mb-2">
                                    <label class="form-label text-muted small mb-1">Start Date</label>
                                    <input type="date"
                                           t-ref="date_from"
                                           t-att-value="state.start_date"
                                           class="form-control form-control-sm"/>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label text-muted small mb-1">End Date</label>
                                    <input type="date"
                                           t-ref="date_to"
                                           t-att-value="state.end_date"
                                           class="form-control form-control-sm"/>
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-primary w-100 mt-1"
                                        t-on-click="applyCustomDates">
                                    Apply Custom Dates
                                </button>
                            </div>
                        </div>

                        <!-- Comparison Dropdown -->
                        <div class="dropdown">
                            <button type="button"
                                    t-attf-class="btn o_filter_chip dropdown-toggle {{ state.apply_comparison ? 'active' : '' }}"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-bar-chart"/>
                                <span>Comparison</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width: 240px;" role="menu">
                                <button class="dropdown-item py-1 mb-2 text-danger" type="button" t-on-click="removeComparison">
                                    <i class="fa fa-times me-1"/> No Comparison
                                </button>
                                <div class="dropdown-divider my-2"/>
                                <div class="mb-2">
                                    <label class="form-label text-muted small mb-1">Previous Period(s):</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" t-ref="periods" min="1" value="1" class="form-control"/>
                                        <button class="btn btn-primary" type="button" t-on-click="applyComparisonPeriod">Apply</button>
                                    </div>
                                </div>
                                <div class="dropdown-divider my-2"/>
                                <div class="mb-1">
                                    <label class="form-label text-muted small mb-1">Same Period Last Year:</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" t-ref="period_year" min="1" value="1" class="form-control"/>
                                        <button class="btn btn-primary" type="button" t-on-click="applyComparisonYear">Apply</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Options Dropdown -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-sliders"/>
                                <span><t t-esc="state.options and state.options.draft ? 'Options: Draft Included' : 'Options: Posted Only'"/></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-2" role="menu">
                                <button t-attf-class="dropdown-item py-2 d-flex align-items-center justify-content-between {{ state.options and state.options.draft ? 'active fw-bold' : '' }}"
                                        type="button"
                                        t-on-click="toggleDraftEntries">
                                    <span>Include Draft Entries</span>
                                    <i t-if="state.options and state.options.draft" class="fa fa-check text-success"/>
                                </button>
                            </div>
                        </div>

                        <!-- Reports / Grouping Dropdown -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-list"/>
                                <span>Grouping</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-2" role="menu">
                                <button t-attf-class="dropdown-item py-1 {{ !state.report_type ? 'active fw-bold' : '' }}"
                                        type="button"
                                        t-on-click="() => this.setReportGrouping('global')">
                                    Generic Tax Report
                                </button>
                                <button t-attf-class="dropdown-item py-1 {{ state.report_type and state.report_type.account ? 'active fw-bold' : '' }}"
                                        type="button"
                                        t-on-click="() => this.setReportGrouping('account')">
                                    Group by: Account &gt; Tax
                                </button>
                                <button t-attf-class="dropdown-item py-1 {{ state.report_type and state.report_type.tax ? 'active fw-bold' : '' }}"
                                        type="button"
                                        t-on-click="() => this.setReportGrouping('tax')">
                                    Group by: Tax &gt; Account
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Executive KPI Dashboard -->
            <div class="o_report_kpi_bar">
                <div class="o_kpi_card">
                    <span class="o_kpi_title">Purchase Tax (Input VAT)</span>
                    <span class="o_kpi_value text-warning"><t t-esc="state.currency"/> <t t-esc="formatNumber(state.purchase_total)"/></span>
                    <span class="o_kpi_sub">Base: <t t-esc="state.currency"/> <t t-esc="formatNumber(state.purchase_net_total)"/></span>
                </div>
                <div class="o_kpi_card">
                    <span class="o_kpi_title">Net Tax Settlement</span>
                    <span t-attf-class="o_kpi_value {{ net_tax_position > 0 ? 'text-danger' : (net_tax_position &lt; 0 ? 'text-success' : 'text-muted') }}">
                        <t t-esc="state.currency"/> <t t-esc="formatNumber(Math.abs(net_tax_position))"/>
                    </span>
                    <div class="o_kpi_sub mt-1">
                        <t t-if="net_tax_position &lt; 0">
                            <span class="badge bg-success text-white py-1 px-2">Refundable / مسترد</span>
                        </t>
                        <t t-elif="net_tax_position > 0">
                            <span class="badge bg-danger text-white py-1 px-2">Payable / واجب السداد</span>
                        </t>
                        <t t-else="">
                            <span class="badge bg-secondary text-white py-1 px-2">Balanced / متزن</span>
                        </t>
                    </div>
                </div>
                <div class="o_kpi_card">
                    <span class="o_kpi_title">Total Taxable Activity</span>
                    <span class="o_kpi_value text-dark"><t t-esc="state.currency"/> <t t-esc="formatNumber(total_taxable_base)"/></span>
                    <span class="o_kpi_sub">Combined Sales &amp; Purchase Base</span>
                </div>
            </div>

            <!-- Informational Banner (Enterprise Alert Look) -->
            <div class="alert alert-info d-flex align-items-center mb-3 py-2 px-3" style="font-size: 12px; border-radius: 6px; background-color: #e7f5ff; border: 1px solid #b7dcf7; color: #0c5460;">
                <i class="fa fa-info-circle text-info me-2 fs-6"/>
                <span>Tax Report summarizes VAT liability. Output Tax on sales is offset against deductible Input Tax on purchases to determine the final net tax payable or refundable.</span>
            </div>

            <!-- Table Card Container -->
            <div class="o_report_table_card">
                <div class="o_report_table_scrollable">
                    <table class="o_bs_table" cellspacing="0">
                        <thead>
                            <tr class="o_tb_super_header">
                                <th colspan="2" style="text-align: left; padding-left: 16px;">Tax Scope / Description</th>
                                <t t-if="state.date_viewed and state.date_viewed.length > 0">
                                    <t t-foreach="state.date_viewed" t-as="dv" t-key="dv_index">
                                        <th colspan="2" style="text-align: center;">
                                            <t t-esc="dv"/>
                                        </th>
                                    </t>
                                </t>
                                <t t-else="">
                                    <th colspan="2" style="text-align: center;">Current Period</th>
                                </t>
                            </tr>
                            <tr class="o_tb_sub_header">
                                <th style="width: 50%; text-align: left; padding-left: 16px;">Tax Rate &amp; Breakdown</th>
                                <th style="width: 10%; text-align: center;">Type</th>
                                <t t-if="state.apply_comparison">
                                    <t t-foreach="comparison_number_range" t-as="num" t-key="num">
                                        <th class="text-end" style="width: 20%;">NET BASE</th>
                                        <th class="text-end" style="width: 20%;">TAX AMOUNT</th>
                                    </t>
                                </t>
                                <th class="text-end" style="width: 20%;">NET BASE</th>
                                <th class="text-end" style="width: 20%;">TAX AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody t-ref="tbody">
                            <t t-if="state.data">
                                <!-- SECTION 1: SALES TAX -->
                                <tr class="o_tax_section_header o_tax_sales_accent">
                                    <td colspan="2" class="fw-bold">
                                        <i class="fa fa-shopping-cart text-primary me-2"/>
                                        <span>Sales (ضريبة المبيعات والمخرجات)</span>
                                    </td>
                                    <t t-if="state.apply_comparison">
                                        <t t-foreach="comparison_number_range" t-as="no" t-key="no">
                                            <td class="text-end fw-semibold">-</td>
                                            <td class="text-end fw-semibold">-</td>
                                        </t>
                                    </t>
                                    <td class="text-end fw-bold text-primary">
                                        <t t-esc="formatNumber(state.sale_net_total)"/>
                                    </td>
                                    <td class="text-end fw-bold text-primary">
                                        <t t-esc="formatNumber(state.sale_total)"/>
                                    </td>
                                </tr>

                                <t t-if="state.data.sale and state.data.sale.length > 0">
                                    <t t-foreach="state.data.sale" t-as="sale_line" t-key="sale_line_index">
                                        <tr class="o_tax_line_row">
                                            <td class="ps-4">
                                                <span class="o_tax_rate_badge me-2">
                                                    <t t-esc="sale_line.name"/>
                                                </span>
                                                <t t-if="sale_line.account">
                                                    <span class="text-muted small ms-1"><t t-esc="sale_line.account"/></span>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-secondary small">Standard Output VAT</span>
                                                </t>
                                            </td>
                                            <td class="text-center text-muted small">Sales</td>
                                            <t t-if="state.apply_comparison and sale_line['dynamic net']">
                                                <t t-foreach="comparison_number_range" t-as="num" t-key="num">
                                                    <td class="text-end text-muted">
                                                        <t t-esc="formatNumber(sale_line['dynamic net']['dynamic_total_net_sum' + num])"/>
                                                    </td>
                                                    <td class="text-end text-muted">
                                                        <t t-esc="formatNumber(sale_line['dynamic tax']['dynamic_total_tax_sum' + num])"/>
                                                    </td>
                                                </t>
                                            </t>
                                            <td class="text-end fw-semibold text-dark">
                                                <t t-esc="formatNumber(sale_line.net)"/>
                                            </td>
                                            <td class="text-end fw-semibold text-primary">
                                                <t t-esc="formatNumber(sale_line.tax)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr class="o_tax_line_row">
                                        <td colspan="4" class="text-muted text-center py-2 small ps-4">No taxable sales recorded in this period</td>
                                    </tr>
                                </t>

                                <!-- SECTION 2: PURCHASE TAX -->
                                <tr class="o_tax_section_header o_tax_purchase_accent">
                                    <td colspan="2" class="fw-bold">
                                        <i class="fa fa-truck text-warning me-2"/>
                                        <span>Purchase (ضريبة المشتريات والمدخلات)</span>
                                    </td>
                                    <t t-if="state.apply_comparison">
                                        <t t-foreach="comparison_number_range" t-as="numb" t-key="numb">
                                            <td class="text-end fw-semibold">-</td>
                                            <td class="text-end fw-semibold">-</td>
                                        </t>
                                    </t>
                                    <td class="text-end fw-bold text-warning">
                                        <t t-esc="formatNumber(state.purchase_net_total)"/>
                                    </td>
                                    <td class="text-end fw-bold text-warning">
                                        <t t-esc="formatNumber(state.purchase_total)"/>
                                    </td>
                                </tr>

                                <t t-if="state.data.purchase and state.data.purchase.length > 0">
                                    <t t-foreach="state.data.purchase" t-as="purchase_line" t-key="purchase_line_index">
                                        <tr class="o_tax_line_row">
                                            <td class="ps-4">
                                                <span class="o_tax_rate_badge me-2" style="background-color: #fef3c7; color: #b45309;">
                                                    <t t-esc="purchase_line.name"/>
                                                </span>
                                                <t t-if="purchase_line.account">
                                                    <span class="text-muted small ms-1"><t t-esc="purchase_line.account"/></span>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-secondary small">Deductible Input VAT</span>
                                                </t>
                                            </td>
                                            <td class="text-center text-muted small">Purchase</td>
                                            <t t-if="state.apply_comparison and purchase_line['dynamic net']">
                                                <t t-foreach="comparison_number_range" t-as="num" t-key="num">
                                                    <td class="text-end text-muted">
                                                        <t t-esc="formatNumber(purchase_line['dynamic net']['dynamic_total_net_sum' + num])"/>
                                                    </td>
                                                    <td class="text-end text-muted">
                                                        <t t-esc="formatNumber(purchase_line['dynamic tax']['dynamic_total_tax_sum' + num])"/>
                                                    </td>
                                                </t>
                                            </t>
                                            <td class="text-end fw-semibold text-dark">
                                                <t t-esc="formatNumber(purchase_line.net)"/>
                                            </td>
                                            <td class="text-end fw-semibold text-warning">
                                                <t t-esc="formatNumber(purchase_line.tax)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr class="o_tax_line_row">
                                        <td colspan="4" class="text-muted text-center py-2 small ps-4">No taxable purchases recorded in this period</td>
                                    </tr>
                                </t>

                                <!-- SECTION 3: NET TAX POSITION FINAL SETTLEMENT ROW -->
                                <tr class="o_tax_net_row">
                                    <td class="fw-bold ps-3 text-uppercase">
                                        <span>Net Tax Due / (Refundable) - صافي الضريبة</span>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="net_tax_position &lt; 0">
                                            <span class="o_tax_refundable_badge">
                                                <i class="fa fa-arrow-down me-1"/> Refundable
                                            </span>
                                        </t>
                                        <t t-elif="net_tax_position > 0">
                                            <span class="o_tax_payable_badge">
                                                <i class="fa fa-arrow-up me-1"/> Payable
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-secondary text-white">Balanced</span>
                                        </t>
                                    </td>
                                    <t t-if="state.apply_comparison">
                                        <t t-foreach="comparison_number_range" t-as="no_end" t-key="no_end">
                                            <td class="text-end fw-bold">-</td>
                                            <td class="text-end fw-bold">-</td>
                                        </t>
                                    </t>
                                    <td class="text-end fw-bold text-white">
                                        <t t-esc="formatNumber(net_tax_base)"/>
                                    </td>
                                    <td t-attf-class="text-end fw-bold {{ net_tax_position > 0 ? 'text-danger' : (net_tax_position &lt; 0 ? 'text-success' : 'text-white') }}" style="font-size: 14px;">
                                        <t t-esc="formatNumber(net_tax_position)"/>
                                    </td>
                                </tr>
                            </t>

                            <!-- Empty State -->
                            <t t-else="">
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="fa fa-percent fa-3x mb-3 text-secondary"/>
                                        <h5 class="fw-semibold">No Tax Activity Found</h5>
                                        <p class="small mb-0">No invoices or bills with tax lines were recorded for this selected period.</p>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
