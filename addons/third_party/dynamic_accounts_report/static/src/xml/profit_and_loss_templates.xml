<?xml version="1.0" encoding="utf-8"?>
<templates>
    <!--
    Profit and Loss Template - Enterprise Grade
    Responsive hierarchy, dark control bar, crisp glassmorphic filters, and tabular financial formatting.
    -->
    <t t-name="dfr_template_new" owl="1">
        <div class="o_partner_ledger_container">
            <!-- Header Control Bar (Enterprise Dark Bar) -->
            <div class="o_report_control_bar">
                <div class="o_report_header_left">
                    <h2 class="o_report_main_title">
                        <i class="fa fa-line-chart me-2"/>
                        <t t-esc="state.title || 'Profit and Loss'"/>
                    </h2>
                    <!-- Action Buttons -->
                    <button type="button"
                            class="o_btn_report_action o_btn_pdf"
                            t-on-click="print_pdf"
                            title="Print PDF Report">
                        <i class="fa fa-file-pdf-o"/> Print (PDF)
                    </button>
                    <button type="button"
                            class="o_btn_report_action o_btn_xlsx"
                            t-on-click="print_xlsx"
                            title="Export XLSX Spreadsheet">
                        <i class="fa fa-file-excel-o"/> Export (XLSX)
                    </button>

                    <!-- Unfold/Fold Toggle Button -->
                    <button type="button"
                            class="btn btn-sm btn-outline-light ms-2 o_filter_chip"
                            style="border-radius: 6px; padding: 5px 12px;"
                            t-on-click="unfoldAll">
                        <i t-attf-class="fa fa-{{ state.is_unfolded_all ? 'compress' : 'expand' }} me-1"/>
                        <t t-esc="state.is_unfolded_all ? 'Fold All' : 'Unfold All'"/>
                    </button>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-2">
                    <!-- Filter Pills (Buttons with white text & glassmorphism) -->
                    <div class="o_filter_pills_group">
                        <!-- 1. Date Range Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-calendar"/>
                                <span>Date Range</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width: 260px;" role="menu">
                                <div class="list-group list-group-flush mb-2">
                                    <button class="dropdown-item py-1" t-att-data-value="'month'" type="button" t-on-click="apply_date">This Month</button>
                                    <button class="dropdown-item py-1" t-att-data-value="'quarter'" type="button" t-on-click="apply_date">This Quarter</button>
                                    <button class="dropdown-item py-1" t-att-data-value="'year'" type="button" t-on-click="apply_date">This Year</button>
                                    <div class="dropdown-divider my-1"/>
                                    <button class="dropdown-item py-1" t-att-data-value="'last-month'" type="button" t-on-click="apply_date">Last Month</button>
                                    <button class="dropdown-item py-1" t-att-data-value="'last-quarter'" type="button" t-on-click="apply_date">Last Quarter</button>
                                    <button class="dropdown-item py-1" t-att-data-value="'last-year'" type="button" t-on-click="apply_date">Last Year</button>
                                </div>
                                <div class="dropdown-divider my-2"/>
                                <div class="mb-2">
                                    <label class="form-label text-muted small mb-1" for="pl_start_date">Start Date</label>
                                    <input type="date" id="pl_start_date" name="start_date" class="form-control form-control-sm" t-on-change="apply_date"/>
                                </div>
                                <div>
                                    <label class="form-label text-muted small mb-1" for="pl_end_date">End Date</label>
                                    <input type="date" id="pl_end_date" name="end_date" class="form-control form-control-sm" t-on-change="apply_date"/>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Comparison Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-signal"/>
                                <span>Comparison</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width: 260px;" role="menu">
                                <button class="dropdown-item py-1" t-att-data-value="'no comparison'" type="button" t-on-click="apply_comparison">No Comparison</button>
                                <div class="dropdown-divider my-2"/>
                                <div class="mb-2">
                                    <label class="form-label small text-muted mb-1">Previous Period (Months)</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" t-ref="periods" min="1" class="form-control" t-on-input="onPeriodChange" placeholder="e.g. 1"/>
                                        <button class="btn btn-outline-primary" type="button" t-on-click="applyComparisonPeriod">Apply</button>
                                    </div>
                                </div>
                                <div>
                                    <label class="form-label small text-muted mb-1">Same Period Last Year</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" t-ref="period_year" min="1" class="form-control" t-on-input="onPeriodYearChange" placeholder="e.g. 1"/>
                                        <button class="btn btn-outline-primary" type="button" t-on-click="applyComparisonYear">Apply</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Journals Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-book"/>
                                <span class="code">Journals</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-2" style="max-height: 280px; overflow-y: auto;" role="menu">
                                <t t-if="state.filter_data and (state.filter_data.journals or state.filter_data.journal)">
                                    <t t-foreach="state.filter_data.journals || state.filter_data.journal" t-as="journal" t-key="journal_index">
                                        <button class="dropdown-item py-1 text-truncate" type="button" t-on-click="apply_journal">
                                            <span style="display:none"><t t-esc="journal.id"/></span>
                                            <t t-esc="journal.name"/>
                                        </button>
                                    </t>
                                </t>
                            </div>
                        </div>

                        <!-- 4. Accounts Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-bookmark"/>
                                <span class="account">Accounts</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-2" style="width: 280px; max-height: 280px; overflow-y: auto;" role="menu">
                                <t t-if="state.filter_data and (state.filter_data.accounts or state.filter_data.account)">
                                    <t t-foreach="state.filter_data.accounts || state.filter_data.account" t-as="account" t-key="account_index">
                                        <button class="dropdown-item py-1 text-truncate" type="button" t-on-click="apply_account">
                                            <span style="display:none"><t t-esc="account.id"/></span>
                                            <t t-esc="account.name"/>
                                        </button>
                                    </t>
                                </t>
                            </div>
                        </div>

                        <!-- 5. Analytic Accounts Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-pie-chart"/>
                                <span class="analytic">Analytic</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-2" style="max-height: 280px; overflow-y: auto;" role="menu">
                                <t t-if="state.filter_data and (state.filter_data.analytics or state.filter_data.analytic)">
                                    <t t-foreach="state.filter_data.analytics || state.filter_data.analytic" t-as="analytic" t-key="analytic_index">
                                        <button class="dropdown-item py-1 text-truncate" type="button" t-on-click="apply_analytic_accounts">
                                            <span style="display:none"><t t-esc="analytic.id"/></span>
                                            <t t-esc="analytic.name"/>
                                        </button>
                                    </t>
                                </t>
                            </div>
                        </div>

                        <!-- 6. Target Move (Posted / Draft) -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-filter"/>
                                <span class="target">Posted Entries</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-1" role="menu">
                                <button class="dropdown-item py-1" type="button" value="posted" t-ref="posted" t-on-click="apply_entries">
                                    Posted Entries Only
                                </button>
                                <button class="dropdown-item py-1" type="button" value="draft" t-ref="draft" t-on-click="apply_entries">
                                    Include Draft Entries
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Informational Banner (Enterprise Alert Look) -->
            <div class="alert alert-info d-flex align-items-center mb-3 py-2 px-3" style="font-size: 12px; border-radius: 6px; background-color: #e7f5ff; border: 1px solid #b7dcf7; color: #0c5460;">
                <i class="fa fa-info-circle text-info me-2 fs-6"/>
                <span>Profit and Loss statement for the selected accounting period. Click on any account name or the external link icon to navigate directly to its General Ledger.</span>
            </div>

            <!-- Table Card Container -->
            <div class="o_report_table_card">
                <div class="o_report_table_scrollable">
                    <table class="o_bs_table" cellspacing="0">
                        <t t-if="state.data and state.datas and state.datas.length > 0">
                            <thead>
                                <tr>
                                    <th style="width: 70%;">Account / Category</th>
                                    <t t-if="state.year">
                                        <t t-foreach="state.year" t-as="periodData" t-key="periodData_index">
                                            <th class="text-end" style="width: 30%;">
                                                <div class="fw-bold"><t t-esc="periodData"/></div>
                                                <small style="font-weight: 500; opacity: 0.75;">Balance</small>
                                            </th>
                                        </t>
                                    </t>
                                </tr>
                            </thead>
                            <tbody t-ref="tbody">
                                <!-- Top Net Profit Highlight Line -->
                                <tr class="o_bs_grand_total_row" >
                                    <td>NET PROFIT</td>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <td class="text-end o_col_num fw-bold fs-6" t-att-class="value.total and value.total &lt; 0 ? 'o_num_negative' : ''">
                                            <t t-esc="formatNumber(value.total)"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- ==================== 1. INCOME ==================== -->
                                <tr class="o_bs_section_header">
                                    <td>INCOME</td>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <td class="text-end o_col_num" t-att-class="value.total_income and value.total_income.includes('-') ? 'o_num_negative' : ''">
                                            <t t-esc="value.total_income"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- 1.1 Gross Profit Subheader -->
                                <tr class="o_bs_group_row">
                                    <td class="ps-3 fw-bold">Gross Profit</td>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <td class="text-end o_col_num fw-bold">
                                            <t t-esc="sumGrossProfit(value.expense_direct_cost[1], value.income[1])"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- 1.1.1 Operating Income (Collapsible) -->
                                <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                    <t t-if="value.income[1] != '0.00'">
                                        <t t-set="income_exist" t-value="1"/>
                                    </t>
                                </t>
                                <t t-if="income_exist == 1">
                                    <tr class="o_bs_group_row" t-on-click="() => this.toggleGroup('income')" style="cursor: pointer;">
                                        <td class="ps-4">
                                            <span class="o_toggle_caret me-2">
                                                <i t-attf-class="fa fa-caret-{{ isGroupExpanded('income') ? 'down text-primary' : 'right text-muted' }}"/>
                                            </span>
                                            <span>Operating Income</span>
                                        </td>
                                        <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                            <td class="text-end o_col_num fw-bold" t-att-class="value.income[1] and value.income[1].includes('-') ? 'o_num_negative' : ''">
                                                <t t-esc="value.income[1]"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <t t-if="value_index == 0">
                                            <t t-foreach="value.income[0]" t-as="data" t-key="data_index">
                                                <t t-if="data.amount != '0.00'">
                                                    <tr t-attf-class="o_bs_account_row {{ isGroupExpanded('income') ? '' : 'd-none' }}">
                                                        <td class="ps-5">
                                                            <span class="o_bs_account_name"><t t-esc="data.name"/></span>
                                                            <a class="o_bs_drilldown_icon" t-on-click="show_gl" title="View General Ledger"><i class="fa fa-external-link"/></a>
                                                        </td>
                                                        <t t-foreach="state.datas" t-as="values" t-key="values_index">
                                                            <t t-foreach="values.income[0]" t-as="sub_data" t-key="sub_data_index">
                                                                <t t-if="data.name == sub_data.name">
                                                                    <td class="text-end o_col_num" t-att-class="sub_data.amount and sub_data.amount.includes('-') ? 'o_num_negative' : ''">
                                                                        <t t-esc="sub_data.amount"/>
                                                                    </td>
                                                                </t>
                                                            </t>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </t>
                                </t>

                                <!-- 1.1.2 Cost of Revenue (Collapsible) -->
                                <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                    <t t-if="value.expense_direct_cost[1] != '0.00'">
                                        <t t-set="expense_direct_cost_exist" t-value="1"/>
                                    </t>
                                </t>
                                <t t-if="expense_direct_cost_exist == 1">
                                    <tr class="o_bs_group_row" t-on-click="() => this.toggleGroup('revenue')" style="cursor: pointer;">
                                        <td class="ps-4">
                                            <span class="o_toggle_caret me-2">
                                                <i t-attf-class="fa fa-caret-{{ isGroupExpanded('revenue') ? 'down text-primary' : 'right text-muted' }}"/>
                                            </span>
                                            <span>Cost of Revenue</span>
                                        </td>
                                        <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                            <td class="text-end o_col_num fw-bold" t-att-class="value.expense_direct_cost[1] and value.expense_direct_cost[1].includes('-') ? 'o_num_negative' : ''">
                                                <t t-esc="value.expense_direct_cost[1]"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <t t-if="value_index == 0">
                                            <t t-foreach="value.expense_direct_cost[0]" t-as="data" t-key="data_index">
                                                <t t-if="data.amount != '0.00'">
                                                    <tr t-attf-class="o_bs_account_row {{ isGroupExpanded('revenue') ? '' : 'd-none' }}">
                                                        <td class="ps-5">
                                                            <span class="o_bs_account_name"><t t-esc="data.name"/></span>
                                                            <a class="o_bs_drilldown_icon" t-on-click="show_gl" title="View General Ledger"><i class="fa fa-external-link"/></a>
                                                        </td>
                                                        <t t-foreach="state.datas" t-as="values" t-key="values_index">
                                                            <t t-foreach="values.expense_direct_cost[0]" t-as="sub_data" t-key="sub_data_index">
                                                                <t t-if="data.name == sub_data.name">
                                                                    <td class="text-end o_col_num" t-att-class="sub_data.amount and sub_data.amount.includes('-') ? 'o_num_negative' : ''">
                                                                        <t t-esc="sub_data.amount"/>
                                                                    </td>
                                                                </t>
                                                            </t>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </t>
                                </t>

                                <!-- 1.2 Other Income (Collapsible) -->
                                <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                    <t t-if="value.income_other[1] != '0.00'">
                                        <t t-set="income_other_exist" t-value="1"/>
                                    </t>
                                </t>
                                <t t-if="income_other_exist == 1">
                                    <tr class="o_bs_group_row" t-on-click="() => this.toggleGroup('other_income')" style="cursor: pointer;">
                                        <td class="ps-3">
                                            <span class="o_toggle_caret me-2">
                                                <i t-attf-class="fa fa-caret-{{ isGroupExpanded('other_income') ? 'down text-primary' : 'right text-muted' }}"/>
                                            </span>
                                            <span class="fw-bold">Other Income</span>
                                        </td>
                                        <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                            <td class="text-end o_col_num fw-bold" t-att-class="value.income_other[1] and value.income_other[1].includes('-') ? 'o_num_negative' : ''">
                                                <t t-esc="value.income_other[1]"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <t t-if="value_index == 0">
                                            <t t-foreach="value.income_other[0]" t-as="data" t-key="data_index">
                                                <t t-if="data.amount != '0.00'">
                                                    <tr t-attf-class="o_bs_account_row {{ isGroupExpanded('other_income') ? '' : 'd-none' }}">
                                                        <td class="ps-5">
                                                            <span class="o_bs_account_name"><t t-esc="data.name"/></span>
                                                            <a class="o_bs_drilldown_icon" t-on-click="show_gl" title="View General Ledger"><i class="fa fa-external-link"/></a>
                                                        </td>
                                                        <t t-foreach="state.datas" t-as="values" t-key="values_index">
                                                            <t t-foreach="values.income_other[0]" t-as="sub_data" t-key="sub_data_index">
                                                                <t t-if="data.name == sub_data.name">
                                                                    <td class="text-end o_col_num" t-att-class="sub_data.amount and sub_data.amount.includes('-') ? 'o_num_negative' : ''">
                                                                        <t t-esc="sub_data.amount"/>
                                                                    </td>
                                                                </t>
                                                            </t>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </t>
                                </t>

                                <!-- Subtotal: Total Income -->
                                <tr class="o_bs_subtotal_row" style="background-color: #f1f5f9; border-bottom: 2px solid #0f172a;">
                                    <td class="fw-bold fs-6">Total Income</td>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <td class="text-end o_col_num fw-bold fs-6" t-att-class="value.total_income and value.total_income.includes('-') ? 'o_num_negative' : ''">
                                            <t t-esc="value.total_income"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- ==================== 2. EXPENSES ==================== -->
                                <tr class="o_bs_section_header">
                                    <td>EXPENSES</td>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <td class="text-end o_col_num" t-att-class="value.total_expense and value.total_expense.includes('-') ? 'o_num_negative' : ''">
                                            <t t-esc="value.total_expense"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- 2.1 Operating Expenses (Collapsible) -->
                                <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                    <t t-if="value.expense[1] != '0.00'">
                                        <t t-set="expense_exist" t-value="1"/>
                                    </t>
                                </t>
                                <t t-if="expense_exist == 1">
                                    <tr class="o_bs_group_row" t-on-click="() => this.toggleGroup('expenses')" style="cursor: pointer;">
                                        <td class="ps-3">
                                            <span class="o_toggle_caret me-2">
                                                <i t-attf-class="fa fa-caret-{{ isGroupExpanded('expenses') ? 'down text-primary' : 'right text-muted' }}"/>
                                            </span>
                                            <span class="fw-bold">Operating Expenses</span>
                                        </td>
                                        <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                            <td class="text-end o_col_num fw-bold" t-att-class="value.expense[1] and value.expense[1].includes('-') ? 'o_num_negative' : ''">
                                                <t t-esc="value.expense[1]"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <t t-if="value_index == 0">
                                            <t t-foreach="value.expense[0]" t-as="data" t-key="data_index">
                                                <t t-if="data.amount != '0.00'">
                                                    <tr t-attf-class="o_bs_account_row {{ isGroupExpanded('expenses') ? '' : 'd-none' }}">
                                                        <td class="ps-5">
                                                            <span class="o_bs_account_name"><t t-esc="data.name"/></span>
                                                            <a class="o_bs_drilldown_icon" t-on-click="show_gl" title="View General Ledger"><i class="fa fa-external-link"/></a>
                                                        </td>
                                                        <t t-foreach="state.datas" t-as="values" t-key="values_index">
                                                            <t t-foreach="values.expense[0]" t-as="sub_data" t-key="sub_data_index">
                                                                <t t-if="data.name == sub_data.name">
                                                                    <td class="text-end o_col_num" t-att-class="sub_data.amount and sub_data.amount.includes('-') ? 'o_num_negative' : ''">
                                                                        <t t-esc="sub_data.amount"/>
                                                                    </td>
                                                                </t>
                                                            </t>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </t>
                                </t>

                                <!-- 2.2 Depreciation & Amortization (Collapsible) -->
                                <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                    <t t-if="value.expense_depreciation[1] != '0.00'">
                                        <t t-set="depreciation_exist" t-value="1"/>
                                    </t>
                                </t>
                                <t t-if="depreciation_exist == 1">
                                    <tr class="o_bs_group_row" t-on-click="() => this.toggleGroup('depreciation')" style="cursor: pointer;">
                                        <td class="ps-3">
                                            <span class="o_toggle_caret me-2">
                                                <i t-attf-class="fa fa-caret-{{ isGroupExpanded('depreciation') ? 'down text-primary' : 'right text-muted' }}"/>
                                            </span>
                                            <span class="fw-bold">Depreciation &amp; Amortization</span>
                                        </td>
                                        <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                            <td class="text-end o_col_num fw-bold" t-att-class="value.expense_depreciation[1] and value.expense_depreciation[1].includes('-') ? 'o_num_negative' : ''">
                                                <t t-esc="value.expense_depreciation[1]"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <t t-if="value_index == 0">
                                            <t t-foreach="value.expense_depreciation[0]" t-as="data" t-key="data_index">
                                                <t t-if="data.amount != '0.00'">
                                                    <tr t-attf-class="o_bs_account_row {{ isGroupExpanded('depreciation') ? '' : 'd-none' }}">
                                                        <td class="ps-5">
                                                            <span class="o_bs_account_name"><t t-esc="data.name"/></span>
                                                            <a class="o_bs_drilldown_icon" t-on-click="show_gl" title="View General Ledger"><i class="fa fa-external-link"/></a>
                                                        </td>
                                                        <t t-foreach="state.datas" t-as="values" t-key="values_index">
                                                            <t t-foreach="values.expense_depreciation[0]" t-as="sub_data" t-key="sub_data_index">
                                                                <t t-if="data.name == sub_data.name">
                                                                    <td class="text-end o_col_num" t-att-class="sub_data.amount and sub_data.amount.includes('-') ? 'o_num_negative' : ''">
                                                                        <t t-esc="sub_data.amount"/>
                                                                    </td>
                                                                </t>
                                                            </t>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </t>
                                </t>

                                <!-- Subtotal: Total Expenses -->
                                <tr class="o_bs_subtotal_row" style="background-color: #f1f5f9; border-bottom: 2px solid #0f172a;">
                                    <td class="fw-bold fs-6">Total Expenses</td>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <td class="text-end o_col_num fw-bold fs-6" t-att-class="value.total_expense and value.total_expense.includes('-') ? 'o_num_negative' : ''">
                                            <t t-esc="value.total_expense"/>
                                        </td>
                                    </t>
                                </tr>

                                <!-- ==================== 3. GRAND TOTAL: NET PROFIT ==================== -->
                                <tr class="o_bs_grand_total_row">
                                    <td>NET PROFIT (Income - Expenses)</td>
                                    <t t-foreach="state.datas" t-as="value" t-key="value_index">
                                        <td class="text-end o_col_num" t-att-class="value.total and value.total &lt; 0 ? 'o_num_negative' : ''">
                                            <t t-esc="formatNumber(value.total)"/>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </t>
                        <t t-else="">
                            <tbody>
                                <tr>
                                    <td colspan="2" class="text-center py-5 text-muted">
                                        <i class="fa fa-spinner fa-spin fa-2x mb-3 text-primary d-block"/>
                                        <span class="fw-semibold">Loading Profit and Loss statement...</span>
                                    </td>
                                </tr>
                            </tbody>
                        </t>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
