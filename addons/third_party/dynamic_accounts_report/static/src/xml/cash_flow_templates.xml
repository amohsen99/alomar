<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!--
    Cash Book Template - Enterprise Grade
    Responsive hierarchy, dark control bar, crisp glassmorphic filters, and tabular financial formatting.
    -->
    <t t-name="csh_b_template_new" owl="1">
        <div class="o_partner_ledger_container">
            <!-- Header Control Bar (Enterprise Dark Bar) -->
            <div class="o_report_control_bar">
                <div class="o_report_header_left">
                    <h2 class="o_report_main_title">
                        <i class="fa fa-money me-2"/>
                        <t t-esc="state.title || 'Cash Book'"/>
                    </h2>
                    <!-- Action Buttons -->
                    <button type="button"
                            class="o_btn_report_action o_btn_pdf"
                            t-on-click="printPdf"
                            title="Print PDF Report">
                        <i class="fa fa-file-pdf-o"/> Print (PDF)
                    </button>
                    <button type="button"
                            class="o_btn_report_action o_btn_xlsx"
                            t-on-click="print_xlsx"
                            title="Export XLSX Spreadsheet">
                        <i class="fa fa-file-excel-o"/> Export (XLSX)
                    </button>

                    <!-- Unfold/Fold Toggle Button -->
                    <button type="button"
                            class="btn btn-sm btn-outline-light ms-2 o_filter_chip"
                            style="border-radius: 6px; padding: 5px 12px;"
                            t-on-click="unfoldAll">
                        <i t-attf-class="fa fa-{{ state.is_unfolded_all ? 'compress' : 'expand' }} me-1"/>
                        <t t-esc="state.is_unfolded_all ? 'Fold All' : 'Unfold All'"/>
                    </button>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-2">
                    <!-- Real-Time Search Box -->
                    <div class="o_report_search_wrapper">
                        <i class="fa fa-search o_search_icon"/>
                        <input type="text"
                               class="form-control form-control-sm o_report_search_input"
                               placeholder="Search entry, move, partner..."
                               t-on-input="onSearchInput"/>
                    </div>

                    <!-- Filter Pills -->
                    <div class="o_filter_pills_group">
                        <!-- 1. Date Range Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-calendar"/>
                                <span><t t-esc="state.date_filter_label || 'Date Range'"/></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width: 260px;" role="menu">
                                <div class="list-group list-group-flush mb-2">
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('month', 'This Month')">This Month</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('quarter', 'This Quarter')">This Quarter</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('year', 'This Year')">This Year</button>
                                    <div class="dropdown-divider my-1"/>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-month', 'Last Month')">Last Month</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-quarter', 'Last Quarter')">Last Quarter</button>
                                    <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyDatePreset('last-year', 'Last Year')">Last Year</button>
                                </div>
                                <div class="dropdown-divider my-2"/>
                                <div class="mb-2">
                                    <label class="form-label text-muted small mb-1" for="cb_start_date">Start Date</label>
                                    <input type="date" id="cb_start_date" t-ref="start_date" class="form-control form-control-sm" t-on-change="applyCustomDate"/>
                                </div>
                                <div>
                                    <label class="form-label text-muted small mb-1" for="cb_end_date">End Date</label>
                                    <input type="date" id="cb_end_date" t-ref="end_date" class="form-control form-control-sm" t-on-change="applyCustomDate"/>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Accounts Filter -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-book"/>
                                <span>Accounts</span>
                                <t t-if="state.selected_account_list and state.selected_account_list.length > 0">
                                    <span class="badge bg-primary ms-1"><t t-esc="state.selected_account_list.length"/></span>
                                </t>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-2" style="max-height: 280px; overflow-y: auto;" role="menu">
                                <t t-if="state.accounts and state.accounts.length > 0">
                                    <t t-foreach="state.accounts" t-as="account" t-key="account.id">
                                        <button t-attf-class="dropdown-item py-1 d-flex align-items-center justify-content-between {{ state.selected_account_list.includes(account.id) ? 'active' : '' }}"
                                                type="button"
                                                t-on-click="() => this.toggleAccountFilter(account.id)">
                                            <span><t t-esc="account.display_name"/></span>
                                            <i t-if="state.selected_account_list.includes(account.id)" class="fa fa-check ms-2"/>
                                        </button>
                                    </t>
                                </t>
                                <t t-else="">
                                    <span class="dropdown-item text-muted py-1">No accounts available</span>
                                </t>
                            </div>
                        </div>

                        <!-- 3. Target Moves Filter (Posted / Draft) -->
                        <div class="dropdown">
                            <button type="button"
                                    class="btn o_filter_chip dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="fa fa-filter"/>
                                <span><t t-esc="state.target_move === 'draft' ? 'Include Draft' : 'Posted Only'"/></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm p-1" role="menu">
                                <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyTargetMove('posted')">
                                    Posted Entries Only
                                </button>
                                <button class="dropdown-item py-1" type="button" t-on-click="() => this.applyTargetMove('draft')">
                                    Include Draft Entries
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Informational Banner (Enterprise Alert Look) -->
            <div class="alert alert-info d-flex align-items-center mb-3 py-2 px-3" style="font-size: 12px; border-radius: 6px; background-color: #e7f5ff; border: 1px solid #b7dcf7; color: #0c5460;">
                <i class="fa fa-info-circle text-info me-2 fs-6"/>
                <span>Cash Book records all physical cash inflows and outflows across cash safes. Click any cash safe header to fold/unfold entries, or click a move to inspect the journal entry.</span>
            </div>

            <!-- Table Card Container -->
            <div class="o_report_table_card">
                <div class="o_report_table_scrollable">
                    <table class="o_bs_table" cellspacing="0">
                        <thead>
                            <tr>
                                <th style="width: 9%;">Date</th>
                                <th style="width: 20%;">Journal / Move</th>
                                <th style="width: 16%;">Partner</th>
                                <th style="width: 20%;">Reference / Communication</th>
                                <th class="text-center" style="width: 7%;">Account</th>
                                <th class="text-end" style="width: 9%;">Debit</th>
                                <th class="text-end" style="width: 9%;">Credit</th>
                                <th class="text-end" style="width: 10%;">Balance</th>
                            </tr>
                        </thead>
                        <tbody t-ref="tbody">
                            <t t-if="state.move_line and state.move_line.length > 0">
                                <t t-foreach="displayed_accounts" t-as="account" t-key="account">
                                    <!-- Account Header Row -->
                                    <tr class="o_cb_account_header" t-on-click="() => this.toggleAccount(account)">
                                        <td colspan="5">
                                            <span class="o_toggle_caret me-2">
                                                <i t-attf-class="fa fa-caret-{{ isAccountExpanded(account) ? 'down text-primary' : 'right text-muted' }}"/>
                                            </span>
                                            <span class="o_cb_account_title"><t t-esc="account"/></span>
                                            <t t-if="state.total and state.total[account]">
                                                <button type="button"
                                                        class="o_cb_journal_item_btn ms-2"
                                                        t-on-click="(ev) => this.gotoJournalItem(state.total[account].account_id, ev)"
                                                        title="View Journal Items">
                                                    <i class="fa fa-arrow-right"/> Journal Items
                                                </button>
                                            </t>
                                        </td>
                                        <td class="text-end fw-semibold">
                                            <t t-if="state.total and state.total[account]">
                                                <t t-esc="formatNumber(state.total[account].total_debit)"/>
                                            </t>
                                        </td>
                                        <td class="text-end fw-semibold">
                                            <t t-if="state.total and state.total[account]">
                                                <t t-esc="formatNumber(state.total[account].total_credit)"/>
                                            </t>
                                        </td>
                                        <td t-attf-class="text-end fw-bold {{ state.total and state.total[account] and state.total[account].balance &lt; 0 ? 'text-danger' : 'text-success' }}">
                                            <t t-if="state.total and state.total[account]">
                                                <t t-esc="formatNumber(state.total[account].balance)"/>
                                            </t>
                                        </td>
                                    </tr>

                                    <!-- Transaction Line Rows -->
                                    <t t-if="state.data and state.data[account]">
                                        <t t-foreach="state.data[account]" t-as="line" t-key="line.id">
                                            <tr t-attf-class="o_cb_line_row {{ isAccountExpanded(account) ? '' : 'd-none' }}">
                                                <td>
                                                    <span class="text-muted"><t t-esc="line.date"/></span>
                                                </td>
                                                <td>
                                                    <a href="#"
                                                       class="o_cb_move_link"
                                                       t-on-click="(ev) => this.gotoJournalEntry(line.move_id ? line.move_id[0] : false, ev)"
                                                       title="View Journal Entry">
                                                        <i class="fa fa-file-text-o me-1"/>
                                                        <t t-esc="line.move_name || (line.move_id ? line.move_id[1] : '')"/>
                                                    </a>
                                                    <span class="o_cb_journal_badge ms-2">
                                                        <t t-esc="line.journal_id ? line.journal_id[1] : ''"/>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="text-truncate text-muted">
                                                        <t t-esc="line.partner_id ? line.partner_id[1] : '-'"/>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="text-truncate text-muted">
                                                        <t t-esc="line.ref || line.name || '-'"/>
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="o_cb_account_code_badge" t-att-title="account">
                                                        <t t-esc="line.account_code || (state.total and state.total[account] and state.total[account].account_code) || account.split(' ')[0]"/>
                                                    </span>
                                                </td>
                                                <td class="text-end" style="white-space: nowrap;">
                                                    <t t-esc="formatAmount(line.debit)"/>
                                                </td>
                                                <td class="text-end" style="white-space: nowrap;">
                                                    <t t-esc="formatAmount(line.credit)"/>
                                                </td>
                                                <td class="text-end text-muted">-</td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="fa fa-folder-open-o fs-3 mb-2 d-block"/>
                                        <span>No cash book entries found for the selected criteria.</span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-end fw-bold py-3" style="font-size: 13px; background-color: #f1f5f9;">
                                    Grand Total
                                </td>
                                <td class="text-end fw-bold py-3" style="background-color: #f1f5f9;">
                                    <t t-esc="formatNumber(state.total_debit)"/>
                                </td>
                                <td class="text-end fw-bold py-3" style="background-color: #f1f5f9;">
                                    <t t-esc="formatNumber(state.total_credit)"/>
                                </td>
                                <td t-attf-class="text-end fw-bold py-3 {{ state.total_balance &lt; 0 ? 'text-danger' : 'text-success' }}" style="font-size: 14px; background-color: #f1f5f9;">
                                    <t t-esc="state.currency"/> <t t-esc="formatNumber(state.total_balance)"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
