# ==============================================================================
# Alomar Odoo Project - Environment Configuration
# ==============================================================================
# IMPORTANT: This instance runs on a shared server with other Odoo instances.
# All resource names and ports are explicitly isolated to prevent conflicts.

# Project Name (used by Docker Compose to namespace containers, volumes, and networks)
COMPOSE_PROJECT_NAME=alomar

# Odoo Community Image Version (18.0, 17.0, etc.)
ODOO_IMAGE_TAG=18.0

# PostgreSQL Image Version
POSTGRES_IMAGE_TAG=15-alpine

# ==============================================================================
# Host Port Mappings (Ensure these do NOT conflict with existing containers)
# Current server usage note:
# - Existing Odoo uses host ports: 8019 and 8072
# - Existing Postgres uses host port: 5433
# Alomar instance uses:
# ==============================================================================
HOST_ODOO_PORT=8029
HOST_CHAT_PORT=8032

# (Optional) Database Host Port. Keep empty/commented if DB is only accessed internally
# HOST_DB_PORT=5434

# ==============================================================================
# Database Credentials (Dedicated to Alomar instance)
# ==============================================================================
POSTGRES_DB=postgres
POSTGRES_USER=alomar_user
POSTGRES_PASSWORD=alomar_secure_db_pass_2026

# ==============================================================================
# Odoo Master Password (for creating, restoring, dropping databases via Web UI)
# Change this to a strong random password!
# ==============================================================================
ODOO_ADMIN_PASSWORD=alomar_super_admin_master_pwd

# ==============================================================================
# Odoo Server Tuning & Isolation
# ==============================================================================
# Filter databases visible to users matching this regex (e.g. only alomar_* DBs)
ODOO_DB_FILTER=^alomar.*$

# Number of worker processes (2 * CPU cores + 1 is typical for production)
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
